---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools, EN_CHECKED } from '../../data/tools';
const base = import.meta.env.BASE_URL;
const qs = [
  { id: 'ide', q: 'Where do you want the AI to live?', opts: [['keep', 'In my current IDE', 'VS Code, JetBrains…'], ['open', 'I’ll switch to an AI-native editor', 'Agent-first editing'], ['terminal', 'In my terminal', 'Repo-native CLI agent']] },
  { id: 'budget', q: 'Monthly budget per person?', opts: [['0', '$0', 'Free tiers only'], ['10', 'Up to ~$10', 'Entry paid tier'], ['30', 'Up to ~$30', 'Serious daily use'], ['100', '$100+', 'Heavy agent use']] },
  { id: 'who', q: 'Who is it for?', opts: [['solo', 'Just me', 'Solo / indie'], ['team', 'My team', 'Rollout, admin, policy']] },
  { id: 'job', q: 'What should it be best at?', opts: [['daily', 'Everyday completions & chat', 'Speed up normal coding'], ['agent', 'Multi-file agent edits', 'Describe it, review the diff'], ['refactor', 'Big refactors in a messy repo', 'Long, careful tasks'], ['review', 'Pull-request workflows', 'GitHub-native review']] },
];
---
<BaseLayout title="Find your AI coding tool (quiz)" description="Answer 4 quick questions and get a recommended AI coding tool — Copilot, Cursor, Devin Desktop or Claude Code — with reasons and current entry prices.">
  <section class="container tool-page">
    <header class="tool-head">
      <p class="kicker">Tool · 4 questions · ~30 seconds</p>
      <h1 class="display-sm">Find your AI coding tool</h1>
      <p class="lead">No sign-up, nothing sent anywhere — it runs in your browser. Recommendations follow the reasoning in our <a href={`${base}reviews/best-ai-coding-assistants-2026/`}>2026 roundup</a>.</p>
    </header>
    <div class="quiz" data-quiz data-base={base}>
      <div class="quiz-progress" aria-hidden="true"><i data-bar></i></div>
      <p class="quiz-step mono" data-step aria-live="polite">Question 1 of {qs.length}</p>
      {qs.map((q, i) => (
        <fieldset class="quiz-q" data-q={q.id} hidden={i !== 0}>
          <legend>{q.q}</legend>
          <div class="opts">
            {q.opts.map(([v, label, sub]) => (
              <button type="button" class="opt" data-value={v}><strong>{label}</strong><span>{sub}</span><i class="opt-key mono" aria-hidden="true">→</i></button>
            ))}
          </div>
          {i > 0 && <button type="button" class="link-btn mono" data-back>← Back</button>}
        </fieldset>
      ))}
      <div class="quiz-result" data-result hidden tabindex="-1"></div>
    </div>
    <p class="fine-print">Prices: individual plans as cited in our articles, checked {EN_CHECKED}. Plans change often — verify on the vendor site.</p>
  </section>
  <script is:inline type="application/json" id="tool-data" set:html={JSON.stringify(tools)} />
</BaseLayout>
<script>
import { initQuiz } from '../../scripts/quiz';
document.addEventListener('astro:page-load', initQuiz);
</script>
