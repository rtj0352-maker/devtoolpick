---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('jaReviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="AIツール レビュー・比較一覧"
  description="DevToolPick日本語版のAIツール・SaaSレビューと比較記事の一覧。AI文字起こし、AIスライド作成、AIデザインツールを料金・機能・向き不向きで解説します。"
  lang="ja"
>
  <section class="container" style="padding:2.5rem 0 3rem">
    <h1 style="margin:0 0 0.6rem">レビュー・比較記事一覧</h1>
    <p style="color:var(--text-muted);max-width:42rem;margin:0 0 1.5rem">
      日本で使えるAIツール・SaaSを、2026年の料金と機能で比較・レビューしています。
    </p>
    <div class="grid-cards">
      {posts.map((post) => (
        <a class="card" href={`${base}ja/reviews/${post.id}/`} style="color:inherit;text-decoration:none">
          {post.data.heroLabel && <div class="badge-row"><span class="badge">{post.data.heroLabel}</span></div>}
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
