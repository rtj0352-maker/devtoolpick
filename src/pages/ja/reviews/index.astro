---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReviewCard from '../../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('jaReviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="AIツール レビュー・比較一覧"
  description="DevToolPick日本語版のAIツール・SaaSレビューと比較記事の一覧。AI文字起こし、AIスライド作成、AIデザインツールを料金・機能・向き不向きで解説します。"
  lang="ja"
>
  <section class="container page-head">
    <p class="eyebrow">{posts.length} 本の記事</p>
    <h1>レビュー・比較記事一覧</h1>
    <p class="lead">日本で使えるAIツール・SaaSを、2026年の料金と機能で比較・レビューしています。</p>
  </section>
  <section class="container" style="padding-bottom:3rem">
    <div class="grid-cards">
      {posts.map((post) => (
        <ReviewCard
          href={`${base}ja/reviews/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          updatedDate={post.data.updatedDate}
          tags={post.data.tags}
          heroLabel={post.data.heroLabel}
          body={post.body}
          lang="ja"
        />
      ))}
    </div>
  </section>
</BaseLayout>
