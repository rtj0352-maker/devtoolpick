---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('jaReviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="AIツール・SaaSのレビューと比較【2026年版】"
  description="AI文字起こし・AIスライド作成・AIデザインツールなど、日本で使えるAI/SaaSツールを料金・機能・メリット・デメリットで徹底比較。2026年最新の購入ガイド。"
  lang="ja"
>
  <section class="container hero">
    <div class="badge-row">
      <span class="badge">日本向けAIツール</span>
      <span class="badge">料金・機能を比較</span>
      <span class="badge">2026年10月更新</span>
    </div>
    <h1>話題のAIツール、結局どれを選べばいい？</h1>
    <p class="lead">
      DevToolPick日本語版では、Notta・イルシル・MiriCanvasなど、日本語で快適に使えるAIツール・SaaSを
      「料金」「できること」「向いている人」の観点で実用的にレビューしています。
      無料プランでどこまでできるか、有料プランに払う価値はあるかを、1記事で判断できるようにまとめました。
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={`${base}ja/reviews/`}>レビュー一覧を見る</a>
      <a class="btn btn-secondary" href={`${base}ja/reviews/notta-review-2026/`}>Notta レビューから読む</a>
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">注目のレビュー・比較</h2>
    <div class="grid-cards">
      {posts.map((post) => (
        <a class="card" href={`${base}ja/reviews/${post.id}/`} style="color:inherit;text-decoration:none">
          {post.data.heroLabel && <div class="badge-row"><span class="badge">{post.data.heroLabel}</span></div>}
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="meta">{post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Tokyo' })}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="container" style="padding-bottom:3rem">
    <div class="note-box">
      <strong>編集方針：</strong>AIツールの料金や機能は頻繁に変わります。各記事では可能な限り公式情報を参照し、
      記事執筆時点の情報であることを明記しています。お申し込み前には必ず公式サイトで最新情報をご確認ください。
      当セクションにはアフィリエイト広告（PR）を含む記事があり、該当記事の冒頭に明記しています。
    </div>
  </section>
</BaseLayout>
