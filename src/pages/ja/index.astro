---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/posts';

const posts = (await getCollection('jaReviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
const lastUpdated = new Date(Math.max(...posts.map((p) => (p.data.updatedDate ?? p.data.pubDate).valueOf())));
---
<BaseLayout
  title="AIツール・SaaSのレビューと比較【2026年版】"
  description="AI文字起こし・AIスライド作成・AIデザインツールなど、日本で使えるAI/SaaSツールを料金・機能・メリット・デメリットで徹底比較。2026年最新の購入ガイド。"
  lang="ja"
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow mono">● 最終更新 {formatDate(lastUpdated, 'ja', 'long')} · {posts.length}本のレビュー</p>
        <h1 class="display">仕事に効くAIを、<br />30秒で選ぶ。</h1>
        <p class="lead">3つの質問に答えるだけのAIツール診断と、公式サイトで確認した料金の早見表。気になったらレビューで詳しくチェック。</p>
      </div>
      <div class="bento">
        <a class="tile tile-lime tile-a" href={`${base}ja/tools/finder/`} data-reveal>
          <span class="tile-top"><code class="mono">3つの質問<br />→ ぴったりの1本</code><span class="arrow-dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg></span></span>
          <strong class="tile-title">AIツール診断</strong>
        </a>
        <a class="tile tile-grey tile-b" href={`${base}ja/reviews/ai-business-efficiency-tools-2026/`} data-reveal>
          <span class="tile-top"><code class="mono">業務別<br />おすすめ早見表</code><span class="arrow-dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg></span></span>
          <strong class="tile-title">業務効率化まとめ</strong>
        </a>
        <a class="tile tile-ink tile-c" href={`${base}ja/tools/finder/`} data-reveal>
          <span class="tile-top"><span class="pill-outline mono">● 料金早見表</span><span class="arrow-dot solid" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg></span></span>
          <ul class="ink-list mono">
            <li><span>Notta</span><span>議事録</span></li>
            <li><span>イルシル</span><span>スライド</span></li>
            <li><span>Catchy</span><span>コピー</span></li>
            <li><span>Value AI Writer</span><span>SEO記事</span></li>
            <li><span>ConoHa AI Canvas</span><span>画像生成</span></li>
          </ul>
          <strong class="tile-title">5ツールを比較</strong>
        </a>
        <a class="tile tile-grey tile-d" href={`${base}ja/reviews/notta-review-2026/`} data-reveal>
          <span class="tile-top"><span class="rec mono"><i aria-hidden="true"></i>REC 00:00</span><span class="arrow-dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg></span></span>
          <strong class="tile-title">Notta レビュー</strong>
        </a>
        <a class="tile tile-lime tile-e" href={`${base}ja/reviews/ai-slide-tools-comparison-2026-irusiru/`} data-reveal>
          <span class="tile-top"><code class="mono">提案書.pptx<span class="caret" aria-hidden="true">▌</span></code><span class="arrow-dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg></span></span>
          <strong class="tile-title">AIスライド比較</strong>
        </a>
        <a class="tile tile-ink tile-bar" href={`${base}ja/reviews/`} data-reveal>
          <span class="pill-lime mono">ALL</span>
          <strong class="tile-title">すべてのレビュー</strong>
          <span class="bar-meta mono"><b>{posts.length}</b> 本 · 料金は確認日つき</span>
          <span class="arrow-dot solid" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="section-head">
      <h2 class="section-title">注目のレビュー・比較</h2>
      <a class="section-link" href={`${base}ja/reviews/`}>すべて見る →</a>
    </div>
    <div class="grid-cards">
      {posts.map((post, i) => (
        <ReviewCard
          href={`${base}ja/reviews/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          updatedDate={post.data.updatedDate}
          tags={post.data.tags}
          heroLabel={post.data.heroLabel}
          body={post.body}
          lang="ja"
          featured={i === 0}
        />
      ))}
    </div>
  </section>

  <section class="container">
    <div class="features">
      <div class="feature">
        <h3>公式情報をもとに解説</h3>
        <p>料金や機能は可能な限り公式サイトを参照し、記事執筆時点の情報であることを明記しています。</p>
      </div>
      <div class="feature">
        <h3>向き不向きがわかる</h3>
        <p>メリットだけでなく注意点や「向いている人」もまとめ、自分に合うかを判断しやすくしています。</p>
      </div>
      <div class="feature">
        <h3>広告は明記</h3>
        <p>アフィリエイト広告（PR）を含む記事は冒頭に明記しています。詳しくは<a href={`${base}ja/disclosure/`}>広告について</a>。</p>
      </div>
    </div>
  </section>

  <section class="container" style="padding-bottom:3rem">
    <div class="note-box">
      <strong>編集方針：</strong>AIツールの料金や機能は頻繁に変わります。お申し込み前には必ず公式サイトで最新情報をご確認ください。
      当セクションにはアフィリエイト広告（PR）を含む記事があり、該当記事の冒頭に明記しています。
    </div>
  </section>
</BaseLayout>
