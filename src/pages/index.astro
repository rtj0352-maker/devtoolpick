---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('reviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="DevToolPick"
  description="Independent reviews and comparisons of AI coding assistants and developer SaaS tools. Buyer-intent guides updated for 2026."
>
  <section class="container hero">
    <div class="badge-row">
      <span class="badge">AI coding tools</span>
      <span class="badge">Buyer-intent reviews</span>
      <span class="badge">Updated Oct 2026</span>
    </div>
    <h1>Pick the right AI coding tool — without the hype.</h1>
    <p class="lead">
      DevToolPick publishes practical comparisons and reviews of AI coding assistants and developer SaaS:
      Cursor, GitHub Copilot, Claude Code, Devin Desktop (formerly Windsurf), and more.
      We focus on workflow fit, real pricing, and trade-offs — so you can decide in one sitting.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={`${base}reviews/`}>Browse reviews</a>
      <a class="btn btn-secondary" href={`${base}reviews/best-ai-coding-assistants-2026/`}>Start with the 2026 roundup</a>
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">Cornerstone guides</h2>
    <div class="grid-cards">
      {posts.map((post) => (
        <a class="card" href={`${base}reviews/${post.id}/`} style="color:inherit;text-decoration:none">
          {post.data.heroLabel && <div class="badge-row"><span class="badge">{post.data.heroLabel}</span></div>}
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">日本語版 / Japanese section</h2>
    <div class="grid-cards">
      <a class="card" href={`${base}ja/`} hreflang="ja" lang="ja" style="color:inherit;text-decoration:none">
        <div class="badge-row"><span class="badge">日本語</span></div>
        <h3>DevToolPick 日本語版</h3>
        <p>Notta・イルシル・MiriCanvas・Value AI Writer・ConoHa AI Canvasなど、日本で使えるAIツール・SaaSのレビューと比較（2026年版）。</p>
      </a>
    </div>
  </section>

  <section class="container" style="padding-bottom:3rem">
    <div class="note-box">
      <strong>How we work:</strong> Pricing and features change fast in this category.
      Every article cites official sources where possible and reminds you to verify before purchase.
      Affiliate links are clearly marked once we join partner programs.
    </div>
  </section>
</BaseLayout>
