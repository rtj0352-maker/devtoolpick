---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout noindex title="Page not found" description="This page doesn't exist. Search DevToolPick or jump to the tool finder.">
  <section class="container nf">
    <div>
      <p class="nf-code">4<span>0</span>4</p>
      <h1>That page isn’t here.</h1>
      <p>It may have moved (our news articles now live under <code>/news/</code>), or the link has a typo. Search the site or start from one of these.</p>
      <p lang="ja">お探しのページは見つかりませんでした。検索するか、下のリンクからどうぞ。</p>
      <div class="nf-actions">
        <button type="button" class="primary" data-palette-open>Search (⌘K)</button>
        <a href={`${base}tools/finder/`}>Tool finder</a>
        <a href={`${base}reviews/`}>All reviews</a>
        <a href={`${base}news/`}>News</a>
        <a href={`${base}ja/`} lang="ja">日本語版</a>
      </div>
    </div>
  </section>
</BaseLayout>
