---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="News"
  description="Developer security and tooling news from DevToolPick: dated, sourced reports with times in JST and clear labels for anything unconfirmed."
>
  <section class="container page-head">
    <p class="eyebrow">{posts.length} reports</p>
    <h1>News</h1>
    <p class="lead">Dated, sourced reports on developer tools and security. Times in JST; unconfirmed claims are labelled.</p>
  </section>
  <section class="container" style="padding-bottom:3rem">
    <div class="grid-cards">
      {posts.map((post) => (
        <ReviewCard
          href={`${base}news/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          updatedDate={post.data.updatedDate}
          tags={post.data.tags}
          heroLabel={post.data.heroLabel}
          body={post.body}
        />
      ))}
    </div>
  </section>
</BaseLayout>
