---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('reviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Reviews & Comparisons"
  description="All DevToolPick reviews and comparisons of AI coding assistants and developer tools."
>
  <section class="container page-head">
    <p class="eyebrow">{posts.length} guides</p>
    <h1>Reviews &amp; comparisons</h1>
    <p class="lead">Cornerstone guides for choosing AI coding tools in 2026.</p>
  </section>
  <section class="container" style="padding-bottom:3rem">
    <div class="grid-cards">
      {posts.map((post) => (
        <ReviewCard
          href={`${base}reviews/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          updatedDate={post.data.updatedDate}
          tags={post.data.tags}
          heroLabel={post.data.heroLabel}
          body={post.body}
        />
      ))}
    </div>
  </section>
</BaseLayout>
