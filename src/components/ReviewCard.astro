---
import { formatDate, readingMinutes, readingLabel, type Lang } from '../lib/posts';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroLabel?: string;
  body?: string;
  lang?: Lang;
  featured?: boolean;
}
const { href, title, description, pubDate, updatedDate, tags = [], heroLabel, body, lang = 'en', featured = false } = Astro.props;
const shown = updatedDate ?? pubDate;
const mins = readingMinutes(body, lang);
---
<a class:list={['card', 'review-card', { featured }]} href={href}>
  <div class="card-top">
    {heroLabel && <span class="badge">{heroLabel}</span>}
    <span class="card-time">{readingLabel(mins, lang)}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="card-foot">
    <ul class="tag-list compact" aria-label={lang === 'ja' ? 'タグ' : 'Tags'}>
      {tags.slice(0, 3).map((t) => <li class="tag">{t}</li>)}
    </ul>
    <time datetime={shown.toISOString()}>{formatDate(shown, lang)}</time>
  </div>
  <span class="card-cta" aria-hidden="true">{lang === 'ja' ? '記事を読む →' : 'Read review →'}</span>
</a>
