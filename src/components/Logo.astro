---
interface Props { size?: number }
const { size = 32 } = Astro.props;
---
<svg class="logo" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id="dtp-logo-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6d8bff" />
      <stop offset="1" stop-color="#2fd4a3" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="url(#dtp-logo-g)" />
  <path d="M22 20 L12 32 L22 44" fill="none" stroke="#0b1020" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M42 20 L52 32 L42 44" fill="none" stroke="#0b1020" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M25 33 L30.5 38.5 L40 26" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
