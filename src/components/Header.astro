---
import Logo from './Logo.astro';
interface Props {
  lang?: 'en' | 'ja';
}
const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links =
  lang === 'ja'
    ? [
        { href: `${base}ja/`, label: 'ホーム', exact: true },
        { href: `${base}ja/tools/finder/`, label: 'AI診断' },
        { href: `${base}ja/reviews/`, label: 'レビュー' },
        { href: `${base}ja/news/`, label: 'ニュース' },
        { href: `${base}ja/disclosure/`, label: '広告について', minor: true },
      ]
    : [
        { href: base, label: 'Home', exact: true },
        { href: `${base}tools/finder/`, label: 'Finder' },
        { href: `${base}tools/compare/`, label: 'Compare' },
        { href: `${base}tools/pricing/`, label: 'Pricing' },
        { href: `${base}reviews/`, label: 'Reviews' },
        { href: `${base}news/`, label: 'News' },
        { href: `${base}about/`, label: 'About', minor: true },
        { href: `${base}disclosure/`, label: 'Disclosure', minor: true },
      ];
const isActive = (l: { href: string; exact?: boolean; minor?: boolean }) => (l.exact ? path === l.href : path.startsWith(l.href));
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={lang === 'ja' ? `${base}ja/` : base}>
      <Logo size={30} />
      <span>DevToolPick{lang === 'ja' && <small class="brand-sub">日本語版</small>}</span>
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="primary-nav" data-menu>
      <span class="sr-only">{lang === 'ja' ? 'メニュー' : 'Menu'}</span><i aria-hidden="true"></i>
    </button>
    <nav id="primary-nav" class="nav-links" aria-label={lang === 'ja' ? 'メインメニュー' : 'Primary'}>
      {links.map((l) => (
        <a href={l.href} class:list={[{ 'nav-minor': l.minor }]} aria-current={isActive(l) ? 'page' : undefined}>{l.label}</a>
      ))}
      {lang === 'ja' ? (
        <a class="lang-switch" href={base} hreflang="en" lang="en">English</a>
      ) : (
        <a class="lang-switch" href={`${base}ja/`} hreflang="ja" lang="ja">日本語</a>
      )}
    </nav>
  </div>
</header>
