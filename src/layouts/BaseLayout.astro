---
import '@fontsource/archivo-black/latin-400.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import displayFont from '@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url';
import '../styles/global.css';
import { GOATCOUNTER_URL } from '../lib/analytics';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  lang?: 'en' | 'ja';
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = 'Independent reviews and comparisons of AI coding assistants and developer SaaS tools. Updated for 2026.',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  lang = 'en',
  ogImage: ogImagePath,
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'DevToolPick';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(canonicalPath, Astro.site).toString();
const base = import.meta.env.BASE_URL;
const ogImage = new URL(ogImagePath ?? `${base}og-default.png`, Astro.site).toString();
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="rMeEYwty2E0506an2DrVq-UIi0Cre7VTmuuRxPfZuOo" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="DevToolPick" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DevToolPick — reviews of AI tools for developers" />
    {lang === 'ja' && <meta property="og:locale" content="ja_JP" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={lang === 'ja' ? 'DevToolPick 日本語版' : 'DevToolPick'} href={`${base}${lang === 'ja' ? 'ja/' : ''}rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="DevToolPick News" href={`${base}news/rss.xml`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {GOATCOUNTER_URL && (
      <script is:inline async data-goatcounter={GOATCOUNTER_URL} src="https://gc.zgo.at/count.js"></script>
    )}
    {ld.map((o) => <script is:inline type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')} />)}
    <ClientRouter />
    <script>import '../scripts/motion.ts'; import '../scripts/analytics.ts'; import '../scripts/palette.ts';</script>
  </head>
  <body>
    <div class="read-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{lang === 'ja' ? '本文へスキップ' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <dialog class="palette" data-palette data-index={`${base}search.json`} data-lang={lang} aria-label={lang === 'ja' ? 'サイト内検索' : 'Search DevToolPick'} transition:persist>
      <div class="palette-box">
        <div class="palette-input">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" data-palette-q placeholder={lang === 'ja' ? '記事・ツールを検索…' : 'Search guides, news and tools…'} autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" />
          <kbd>Esc</kbd>
        </div>
        <ul id="palette-list" class="palette-list" role="listbox" data-palette-list></ul>
        <p class="palette-foot"><span><kbd>↑</kbd><kbd>↓</kbd> {lang === 'ja' ? '選択' : 'navigate'}</span><span><kbd>↵</kbd> {lang === 'ja' ? '開く' : 'open'}</span><span><kbd>⌘K</kbd> {lang === 'ja' ? '開閉' : 'toggle'}</span></p>
      </div>
    </dialog>
    <div class="toast" role="status" aria-live="polite" data-toast transition:persist></div>
  </body>
</html>
