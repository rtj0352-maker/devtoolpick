---
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { formatDate, readingMinutes, readingLabel } from '../lib/posts';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroLabel?: string;
  lang?: 'en' | 'ja';
  headings?: Heading[];
  body?: string;
  verdict?: string;
  pros?: string[];
  cons?: string[];
  faq?: { q: string; a: string }[];
  section?: 'reviews' | 'news';
}

const { title, description, pubDate, updatedDate, tags = [], heroLabel, lang = 'en', headings = [], body, verdict, pros, cons, faq, section = 'reviews' } = Astro.props;
const base = import.meta.env.BASE_URL;
const isJa = lang === 'ja';
const isNews = section === 'news';
const collection = isNews ? (isJa ? 'jaNews' : 'news') : isJa ? 'jaReviews' : 'reviews';
const reviewsPath = `${base}${isJa ? 'ja/' : ''}${section}/`;
const sectionName = isNews ? (isJa ? 'ニュース' : 'News') : isJa ? 'レビュー' : 'Reviews';

// Related: most shared tags first, then newest.
const related = (await getCollection(collection, ({ data }) => !data.draft))
  .filter((p) => p.data.title !== title)
  .map((p) => ({ p, score: p.data.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.p);

const toc = headings.filter((h) => h.depth === 2);
if (faq?.length && !toc.some((h) => h.slug === 'faq')) toc.push({ depth: 2, slug: 'faq', text: isJa ? 'よくある質問' : 'FAQ' });
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).toString();
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': isNews ? 'NewsArticle' : 'Article', headline: title, description,
    datePublished: pubDate.toISOString(), dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: isJa ? 'ja-JP' : 'en', mainEntityOfPage: url, image: new URL(`${base}og-default.png`, site).toString(),
    author: { '@type': 'Organization', name: isJa ? 'DevToolPick 編集部' : 'DevToolPick Editorial', url: new URL(base, site).toString() },
    publisher: { '@type': 'Organization', name: 'DevToolPick', logo: { '@type': 'ImageObject', url: new URL(`${base}apple-touch-icon.png`, site).toString() } },
    keywords: tags.join(', '),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isJa ? 'ホーム' : 'Home', item: new URL(isJa ? `${base}ja/` : base, site).toString() },
      { '@type': 'ListItem', position: 2, name: sectionName, item: new URL(reviewsPath, site).toString() },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
if (faq?.length) jsonLd.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const mins = readingMinutes(body, lang);
---
<BaseLayout title={title} description={description} ogType="article" lang={lang} jsonLd={jsonLd}>
  <div class="container article-wrap">
    <nav class="breadcrumbs" aria-label={isJa ? 'パンくずリスト' : 'Breadcrumb'}>
      <a href={isJa ? `${base}ja/` : base}>{isJa ? 'ホーム' : 'Home'}</a>
      <span aria-hidden="true">/</span>
      <a href={reviewsPath}>{sectionName}</a>
    </nav>
    <header class="article-head">
      {heroLabel && <span class="badge">{heroLabel}</span>}
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
      <div class="article-meta">
        <span>{isJa ? 'DevToolPick 編集部' : 'DevToolPick Editorial'}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{isJa ? `公開日 ${formatDate(pubDate, lang, 'long')}` : `Published ${formatDate(pubDate, lang, 'long')}`}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={updatedDate.toISOString()}>{isJa ? `更新日 ${formatDate(updatedDate, lang, 'long')}` : `Updated ${formatDate(updatedDate, lang, 'long')}`}</time>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{readingLabel(mins, lang)}</span>
        <span class="share-row">
          <button type="button" class="share-btn" data-share="copy" aria-label={isJa ? 'リンクをコピー' : 'Copy link'}><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>{isJa ? 'コピー' : 'Copy link'}</button>
          <button type="button" class="share-btn" data-share="native"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M12 3v13"/><path d="m7 8 5-5 5 5"/></svg>{isJa ? '共有' : 'Share'}</button>
        </span>
      </div>
    </header>
    <div class="disclosure-wrap"><AffiliateDisclosure lang={lang} /></div>

    <div class:list={['article-grid', { 'has-toc': toc.length >= 3 }]}>
      {toc.length >= 3 && (
        <aside class="toc">
          <details open>
            <summary>{isJa ? '目次' : 'On this page'}</summary>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </details>
          <div class="glance">
            {verdict && (<p class="glance-verdict"><strong>{isJa ? '結論' : 'Verdict'}</strong>{verdict.length > 150 ? `${verdict.slice(0, 147).replace(/\s+\S*$/, '')}…` : verdict}</p>)}
            <dl>
              <dt>{isJa ? '最終確認' : 'Last checked'}</dt><dd><time datetime={(updatedDate ?? pubDate).toISOString()}>{formatDate(updatedDate ?? pubDate, lang, 'long')}</time></dd>
              {pros && <><dt>{isJa ? '良い点／注意点' : 'Pros / cons'}</dt><dd>{pros.length} / {cons?.length ?? 0}</dd></>}
            </dl>
            <div class="glance-actions">
              {verdict && <a href="#verdict">{isJa ? '結論へ' : 'Verdict'}</a>}
              {faq?.length ? <a href="#faq">FAQ</a> : null}
              <button type="button" data-share="copy">{isJa ? 'リンクをコピー' : 'Copy link'}</button>
            </div>
          </div>
        </aside>
      )}
      <article class="prose">
        {verdict && (
          <div class="verdict" id="verdict"><strong>{isJa ? '結論' : 'Quick verdict'}</strong><p>{verdict}</p></div>
        )}
        {pros && cons && (
          <div class="pros-cons">
            <div class="pros"><strong>{isJa ? '良い点' : 'Pros'}</strong><ul>{pros.map((p) => <li>{p}</li>)}</ul></div>
            <div class="cons"><strong>{isJa ? '注意点' : 'Cons'}</strong><ul>{cons.map((c) => <li>{c}</li>)}</ul></div>
          </div>
        )}
        <slot />
        {faq && faq.length > 0 && (
          <section class="faq-block" aria-labelledby="faq">
            <h2 id="faq">{isJa ? 'よくある質問' : 'FAQ'}</h2>
            {faq.map((f) => (
              <details class="faq"><summary>{f.q}</summary><div><p>{f.a}</p></div></details>
            ))}
          </section>
        )}
        {tags.length > 0 && (
          <ul class="tag-list" aria-label={isJa ? 'タグ' : 'Tags'}>
            {tags.map((t) => <li class="tag">{t}</li>)}
          </ul>
        )}
      </article>
    </div>

    <aside class="lang-cross" data-reveal>
      {isJa ? (
        <a href={`${base}reviews/`} hreflang="en" lang="en">
          <span class="badge">English</span>
          <strong>Developer? Read our English AI coding tool reviews →</strong>
          <span>Cursor, GitHub Copilot, Claude Code and more, compared by workflow fit and pricing.</span>
        </a>
      ) : (
        <a href={`${base}ja/reviews/`} hreflang="ja" lang="ja">
          <span class="badge">日本語</span>
          <strong>日本語のAIツールレビューも読む →</strong>
          <span>Notta・イルシル・Catchyなど、日本で使える業務効率化AIを料金と無料枠で比較。</span>
        </a>
      )}
    </aside>

    {related.length > 0 && (
      <section class="related">
        <h2 class="section-title">{isJa ? 'あわせて読みたい' : 'Keep reading'}</h2>
        <div class="grid-cards">
          {related.map((post) => (
            <ReviewCard
              href={`${reviewsPath}${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              updatedDate={post.data.updatedDate}
              tags={post.data.tags}
              heroLabel={post.data.heroLabel}
              body={post.body}
              lang={lang}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
